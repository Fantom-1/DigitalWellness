# Google Gemini API Key (Get free from https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key"

# Supabase PostgreSQL Connection String (Free Tier)
# Get from Supabase Project Settings > Database > Connection String (URI or Pooler)
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres"

